# Wi-Fi credentials + mDNS name are baked into the firmware at build time.
# `cp .env.example .env` and fill this in, or export the same variables.
WIFI_SSID=your-ssid
WIFI_PASSWORD=your-password
# Hostname advertised over mDNS, i.e. http://<MDNS_HOSTNAME>.local/
MDNS_HOSTNAME=embassy
# Optional: GPIO wired to the PN532's RSTPDN (active low). Empty = not wired, and
# the reader then needs a power cycle if the chip is ever caught mid-transaction by
# an ESP32 reset. DevKit: 25/26/27 are free. AtomS3 Lite spare header: 5/6/7/8/38/39.
# Wire RSTPDN, not RSTO (RSTO is an output on the module).
PN532_RESET_PIN=
